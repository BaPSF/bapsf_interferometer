# Acquisition (interf_main.py) as a system unit, beside diag-ioc@interferometer.
# Install as root, after diag-ioc@.service's steps (the diag-ioc account, /opt/bapsf_interferometer and its venv):
#   cp deploy/systemd/interf-acquire.service /etc/systemd/system/
#   install -d /etc/interferometer && cp deploy/systemd/acquire.env.example /etc/interferometer/acquire.env   # set LECROY_IP and RIGOL_IP
#   # stop the running acquisition first (only one may talk to the scopes), then copy its shot_counter.json to
#   # /var/lib/interf-acquire/ so numbering continues:
#   #   install -o lapd -g lapd -D -m 0644 <its shot_counter.json> /var/lib/interf-acquire/shot_counter.json
#   systemctl daemon-reload && systemctl enable --now interf-acquire   # enabled at boot, as are the other three units (D10)
# Log: journalctl -u interf-acquire, and /var/log/interferometer/interf_acquire.log.
[Unit]
Description=Interferometer acquisition (interf_main)
After=network-online.target diag-ioc@interferometer.service
Wants=network-online.target diag-ioc@interferometer.service
# After= orders process starts only: the IOC listens about 1.3 s after it starts, and the link retries until the socket
# is there. Never Requires=, BindsTo= or PartOf=: an IOC that stops or crashes must never stop acquisition (D5).

[Service]
Type=simple
# lapd, the operators' account: it holds the NERSC stream key, renewed daily (D10). The diag-ioc group gives it the
# IOC's 0660 link socket. No IPAddressDeny=: it talks to the scopes.
User=lapd
Group=lapd
SupplementaryGroups=diag-ioc
WorkingDirectory=/opt/bapsf_interferometer
Environment=INTERF_IOC_LINK=unix:/run/diag-ioc/interferometer/link.sock
# Not the account's ~/data: the log and the shot counter go to /var/log/interferometer and /var/lib/interf-acquire
# (both local disk, the state outside the log directory, D14). Not shared with interf-store.service: systemd re-owns a
# state directory to its unit's User= at every start.
Environment=INTERF_LOG_DIR=/var/log/interferometer
Environment=INTERF_SHOT_STATE=/var/lib/interf-acquire/shot_counter.json
LogsDirectory=interferometer
StateDirectory=interf-acquire
Environment=PYTHONUNBUFFERED=1
# LECROY_IP and the other acquisition settings (docs/ACQUISITION.md, Configuration); it can also override the lines above.
EnvironmentFile=/etc/interferometer/acquire.env
ExecStart=/opt/bapsf_interferometer/.venv/bin/python interf_main.py
# SIGTERM finishes the shot being read, sets the LeCroy to NORM and the Rigol to RUN, then exits; a second signal
# skips that, so give it time rather than letting systemd SIGKILL it.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
