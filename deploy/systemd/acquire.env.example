# Environment for interf-acquire.service: copy to /etc/interferometer/acquire.env. Every variable is in the
# Configuration table of docs/ACQUISITION.md.
LECROY_IP=10.10.10.10
# INTERF_IOC_LINK is set by the unit to the IOC's socket; INTERF_IOC_LINK= here runs acquisition without the IOC.
# The unit sets INTERF_LOG_DIR and INTERF_SHOT_STATE under /var/log and /var/lib.
# PNG's run and shot numbers in each raw shot (both or neither; needs pyepics, the clients extra):
INTERF_PNG_RUN_PV=PNG:RunNumber
INTERF_PNG_SHOT_PV=PNG:ShotNumber
# If PNG's IOC is on another subnet, CA cannot find it by broadcast: add its address here, e.g.
# EPICS_CA_ADDR_LIST=<PNG IOC address>
# The raw ADIOS archive, a direct ADIOS path; unset writes none:
# INTERF_RAW_OUTPUT=
