# Environment for interf-acquire.service: copy to /etc/interferometer/acquire.env. Every variable is in the
# Configuration table of docs/ACQUISITION.md.
LECROY_IP=10.10.10.10
# INTERF_IOC_LINK is set by the unit to the IOC's socket; INTERF_IOC_LINK= here runs acquisition without the IOC.
# The unit sets INTERF_LOG_DIR and INTERF_SHOT_STATE under /var/log and /var/lib.
